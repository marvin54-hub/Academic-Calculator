# GEMINI_API_KEY: Required for the AI Academic Assistant.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Required. A Postgres connection string.
# - On Vercel: install a Postgres integration (e.g. Neon) from the
#   Marketplace and this gets set automatically.
# - Locally: use the same Neon connection string (from the Neon/Vercel
#   dashboard), or point this at any local/self-hosted Postgres instance,
#   e.g. postgres://postgres:password@localhost:5432/academic_calculator
DATABASE_URL="postgres://user:password@host:5432/dbname"

# APP_URL: The base URL this app is reachable at. Used to build password
# reset links. For local dev, http://localhost:3000 is correct as-is.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Required in production. Signs the login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="MY_RANDOM_SESSION_SECRET"

# --- Optional: password reset emails ---
# If these are not set, "Forgot password" still works, but the reset link
# is returned directly in the API response instead of being emailed
# (there's no email provider to send it otherwise).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Academic Calculator <no-reply@your-domain.com>"
